{
  "name": "dsh-console-plugin",
  "version": "0.5.65-guard.1",
  "description": "（加固分支 dsh-console-guard，基于上游 0.5.64）DSH控制台面板：扫码/6位码配对鸿蒙 App；仅局域网、无云端/隧道/屏幕控制/手机端插件安装/手机端升级。",
  "license": "MIT",
  "author": "CJ <ChenJun25@users.noreply.github.com>",
  "contributors": [
    "dsh-console-guard hardening fork"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzhswddd/dsh-console-guard.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.5",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "lib/*.js",
    "lib/*.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/guard/run.mjs",
    "test:legacy-upstream": "node test/selftest.mjs"
  },
  "homepage": "https://github.com/lzhswddd/dsh-console-guard#readme",
  "bugs": {
    "url": "https://github.com/lzhswddd/dsh-console-guard/issues"
  }
}
